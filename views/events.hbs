{{#block "style"}}
h1 {
    font-size: 2rem;
    margin-bottom: 1.5rem;
}
.event {
    margin-bottom: 1rem;
    line-height: 1.5rem;
}
.event-title {
    display: block;
    font-size: 1.25rem;
}
.event-venue {
    display: block;
}
{{/block}}

<h1>Upcoming Events</h1>

<ol>
  {{#each events}}
    <li class="event">
      <span class="event-title"><a href="{{ mounts.events }}/event/{{ slug }}">{{ title }}</a></span>
      <span class="event-venue">{{ venue_name }}</span>
      <span class="event-date">{{ date start timezone }}</span>
      <span class="event-time">{{ hour start timezone }} {{ day_period start timezone }}&ndash;{{ hour end timezone }} {{ day_period end timezone }}</span>
    </li>
  {{/each}}
</ol>
