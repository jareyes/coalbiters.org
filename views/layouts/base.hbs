<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />

    <link rel="apple-touch-icon" sizes="180x180" href="/img/favicon/apple-touch-icon.png">
    <link rel="icon" type="image/png" sizes="32x32" href="/img/favicon/favicon-32x32.png">
    <link rel="icon" type="image/png" sizes="16x16" href="/img/favicon/favicon-16x16.png">
    <link rel="manifest" href="/img/favicon/site.webmanifest">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Roboto&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="/css/reset.css" />
    <link rel="stylesheet" href="/css/coalbiters.css" />
    <title>Coalbiters Club{{#if @root.title}} | {{ @root.title }}{{/if}}</title>
    {{#if style}}
    <style>
      {{{ style }}}
    </style>
    {{/if}}
    {{#if scripts}}{{{ scripts }}}{{/if}}
  </head>
  <body>
    <header>
      <nav id="nav">
        <ul>
          <li><a href="/events">Upcoming Events{{#if event_count }} ({{ event_count }}){{/if}}</a></li>
          <li><a href="/about">About Coalbiters</a></li>
        </ul>
      </nav>
    </header>
    <article>
      <div id="main">
        {{{ body }}}
      </div>
    </article>
    <footer>
      <p id="footer">&copy;2026 Claremont Coalbiters Club
      </p>
    </footer>
  </body>
</html>
