{{#block "style"}}
article {
    align-items: flex-start;
}
#main {
    width: 100%;
}
h1 {
    font-size: 0.9rem;
    font-variant: small-caps;
    padding-bottom: 0.25rem;
    margin-bottom: 1rem;
    border-bottom: 1px solid var(--cb-color-black);
}
label {
    font-size: 0.8rem;
    display: block;
    font-weight: 600;
    margin-bottom: 0.25rem;
}
input {
    width: 100%;
    border: 1px solid var(--cb-color-black);
    height: 1.5rem;
}
textarea {
    width: 100%;
    height: 8rem;
    border: 1px solid var(--cb-color-black);
}
.form-field {
    margin-bottom: 1rem;
}
{{/block}}

<h1>Event</h1>

<form>
  <div class="form-field">
    <label for="title">Title</label>
    <input type="text" name="title" value="{{ event.title }}">
  </div>
  <div class="form-field">
    <label for="subtitle">Subtitle</label>
    <input type="text" name="subtitle" value="{{ event.subtitle }}">    
  </div>
  <div class="form-field">
    <label for="slug">Slug</label>
    <input type="text" name="slug" value="{{ event.slug }}">
  </div>
  <div class="form-field">
    <label for="start">Start Time</label>
    <input type="text" name="start" value="{{ humanized_date event.start }}">
  </div>
  <div class="form-field">
    <label for="end">End Time</label>
    <input type="text" name="end" value="{{ humanized_date event.end }}">
  </div>
  <div class="form-field">
    <label for="timezone">Timezone</label>
    <input type="text" name="timezone" value="{{ event.timezone }}">
  </div>
  <div class="form-field">
    <label for="price_cents">Price (Cents)</label>
    <input type="number" name="price_cents" value="{{ event.price_cents }}">
  </div>
  <div class="form-field">
    <label for="description">Description</label>
    <textarea name="description">{{ event.description }}</textarea>    
  </div>
  <div class="form-field">
    <label for="icalender_id">iCal ID</label>
    <input type="text" name="end" value="{{ event.icalendar_id }}">
  </div>
  <div class="form-field">
    <label for="directions">Directions</label>
    <textarea name="directions">{{ event.directions }}</textarea>
  </div>
  <div class="form-field">
    <label for="venue_name">Venue</label>
    <input type="text" name="venue_name" value="{{ event.venue_name }}">
  </div>
  <div class="form-field">
    <label for="venue_address">Venue Address</label>
    <input type="text" name="venue_address" value="{{ event.venue_address }}">
  </div>
  <div class="form-field">
    <label for="venue_url">Venue URL</label>
    <input type="url" name="venue_url" value="{{ event.venue_url }}">
  </div>
  <div class="form-field">
    <label for="latitude">Latitude</label>
    <input type="number" name="latitude" value="{{ event.latitude }}">
  </div>
  <div class="form-field">
    <label for="longitude">Longitude</label>
    <input type="number" name="longitude" value="{{ event.longitude }}">
  </div>
  <div class="form-field">
    <label for="location_url">Location URL</label>
    <input type="url" name="location_url" value="{{ event.location_url }}">
  </div>
  <button type="submit">Save</button>
</form>
