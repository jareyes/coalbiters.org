{{#block "style"}}
article {
    align-items: flex-start;
}
#main {
    width: 100%;
}
h1 {
    font-size: 0.9rem;
    font-variant: small-caps;
    padding-bottom: 0.25rem;
    margin-bottom: 1rem;
    border-bottom: 1px solid var(--cb-color-black);
}
.event-title {
    font-weight: 500;
}
{{/block}}
<h1>Events</h1>

<ol>
  {{#each events}}
  <li>
    <span class="event-title">{{ title }}</span>
    <a href="{{ ../MOUNTS.admin }}/event/{{ event_id }}">Edit</a>
    <a href="{{ ../MOUNTS.events }}/{{ slug }}">View</a>
  </li>
  {{/each}}
</ol>
