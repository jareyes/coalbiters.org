BEGIN:VCALENDAR
VERSION:2.0
PRODID:-//coalbiters.org//ical//EN
BEGIN:VEVENT
UID:{{ event.icalendar_id }}
SEQUENCE:0
DTSTAMP:{{ ical_date event.updated_at }}
DTSTART:{{ ical_date event.start }}
DTEND:{{ ical_date event.end }}
SUMMARY:Claremont Coalbiters {{{ event.title }}}
LOCATION:"{{{ event.venue_name }}}, {{{ event.venue_address }}}"
DESCRIPTION:"{{{ event.directions }}}"
URL;VALUE=URI:https://coalbiters.com/event/{{ event.slug }}
END:VEVENT
END:VCALENDAR
