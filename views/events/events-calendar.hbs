{{#block "style"}}
article {
    align-items: flex-start;
}
h1 {
    font-variant: small-caps;
    font-size: 0.9rem;
    margin-bottom: 0.5rem;
}
#main {
    width: 100%;
}
.event-week {
    display: flex;
    flex-direction: row;
    justify-content: space-evenly;
}
.event-day {
    width: 35px;
    height: 35px;
    display: flex;
    align-items: center;
    justify-content: center;
    border-radius: 50%;
    margin: 0 5px;
    background: var(--cb-color-black);
    font-weight: bold;
    color: white;
    font-size: 0.85rem;
}
.event-active {
}
{{/block}}
<h1>This Week</h1>
<div class="event-week">
  {{#each days}}
  <span class="event-day{{#if active}} event-active{{/if}}">{{ day this ../timezone }}</span>
  {{/each}}
</div>
